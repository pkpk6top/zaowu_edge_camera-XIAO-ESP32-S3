# 通用默认值（目标相关的在 sdkconfig.defaults.esp32s3）

# ── 分区：8MB flash 下给应用 4MB（esp_rtsp_service + esp32-camera + mbedtls 一起不小）──
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# ── PSRAM 必须开：OV2640 的帧缓冲（CAMERA_FB_IN_PSRAM）没有它分配不出来 ──
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ── 媒体服务：只保留 RTSP 推流端所需的 SINK 角色 ──
CONFIG_ESP_RTSP_SERVICE_SINK_SUPPORT=y
CONFIG_ESP_RTSP_SERVICE_SRC_SUPPORT=n
CONFIG_ESP_RTSP_SERVICE_SERVER_SUPPORT=n
CONFIG_ESP_MEDIA_DUMMY_SERVICE_SRC_SUPPORT=n
CONFIG_ESP_MEDIA_DUMMY_SERVICE_SINK_SUPPORT=n
CONFIG_ESP_MCP_ENABLE=n

# RTSP 推流的 RTP 缓冲与 LWIP 队列
CONFIG_LWIP_MAX_UDP_PCBS=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64

# ── 任务与调试 ──
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
# 采集与推流任务会在队列上阻塞等待，看门狗在这里只会造成误复位（与官方 RTSP 例程同一取舍）
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_INT_WDT=n

# ── HTTPS 注册需要系统 CA 包 ──
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
